// MedLink AI INPUT example (JSONC: comments are explanatory and must be removed before JSON parsing).
// Source: question_bank.json + MedLink_Question_Bank_Guide.md sections 8.2–8.5.
// All patient values below are synthetic test data, not a real patient record or clinical recommendation.
// This example is generated from the bank's actual rules for one selected symptom: SYM_CHEST_PAIN.
// The exact traversal and IDs were validated against the supplied bank.
// IMPORTANT unresolved mismatch: this Guide says emergency rules run after EVERY answer and at completion; the earlier MedLink decision was final detection after Submit. This sample reports the completed-session alerts only. Confirm the runtime policy before implementation; do not silently change the agreed decision.
{
  // Synthetic session identifier; use a UUID generated by the application, never a real patient identifier.
  "sessionId": "7d5b6c30-9f2a-4a6d-8c11-2a4b7f0d91e3",
  // Must match question_bank.json meta.schemaVersion and meta.status exactly.
  "bank": {
    "schemaVersion": "1.0.0",
    "status": "DRAFT_PENDING_PHYSICIAN_REVIEW"
  },
  // Language used by the patient UI. questionEn and selected[].textEn remain English for the model.
  "language": "ar",
  // UTC ISO-8601 timestamp at questionnaire completion. Synthetic timestamp for this example.
  "completedAt": "2026-11-13T07:30:00Z",
  // COMPLETED means all selected symptom paths ended normally. OUT_OF_SCOPE_AGE must not be sent to AI.
  "endReason": "COMPLETED",
  // Symptom IDs selected by the patient; the order determines the path order.
  "selectedSymptoms": [
    "SYM_CHEST_PAIN"
  ],
  // Derived from common answers. pregnant=null because the example is male and CQ_03 is not asked on this path.
  "demographics": {
    "ageYears": 45,
    "sex": "MALE",
    "pregnant": null
  },
  // Client-reported alerts only. Backend MUST recompute these rules from the submitted answers.
  "emergencyAlertsTriggered": [],
  // One object per answered question, in questionnaire path order. IDs + English text are both included.
  // Choice answers use selected[]; NUMBER/SCALE use value; DURATION uses value + unit + normalized valueInDays.
  "answers": [
    // CQ_01 — Age changes which conditions are relevant and which questions are appropriate; also confirms the case is within adult Internal Medicine scope. | العمر يغيّر الاحتمالات المرضية والأسئلة المناسبة، ويؤكد أن الحالة ضمن نطاق الباطنة للبالغين.
    {
      "questionId": "CQ_01",
      "scope": "COMMON",
      "type": "NUMBER",
      "bodySystemId": "GENERAL",
      "questionEn": "What is your age (in years)?",
      "value": 45
    },
    // CQ_02 — Sex affects the likelihood of certain conditions and decides whether pregnancy questions apply. | الجنس يؤثر على احتمالية بعض الأمراض ويحدد هل تنطبق أسئلة الحمل.
    {
      "questionId": "CQ_02",
      "scope": "COMMON",
      "type": "SINGLE_CHOICE",
      "bodySystemId": "GENERAL",
      "questionEn": "What is your sex?",
      "selected": [
        {
          "optionId": "CQ_02_MALE",
          "textEn": "Male"
        }
      ]
    },
    // CQ_04 — Chronic conditions strongly shape risk and the meaning of new symptoms. | الأمراض المزمنة تحدد المخاطر ومعنى الأعراض الجديدة.
    {
      "questionId": "CQ_04",
      "scope": "COMMON",
      "type": "MULTIPLE_CHOICE",
      "bodySystemId": "GENERAL",
      "questionEn": "Do you have any chronic diseases? (select all that apply)",
      "selected": [
        {
          "optionId": "CQ_04_NONE",
          "textEn": "None"
        }
      ]
    },
    // CQ_05 — Current medicines can cause or mask symptoms and affect later safety decisions. | الأدوية الحالية قد تسبب الأعراض أو تخفيها وتؤثر على قرارات السلامة لاحقًا.
    {
      "questionId": "CQ_05",
      "scope": "COMMON",
      "type": "MULTIPLE_CHOICE",
      "bodySystemId": "GENERAL",
      "questionEn": "Which medicines do you currently take? (select all that apply)",
      "selected": [
        {
          "optionId": "CQ_05_NONE",
          "textEn": "I take no medicines"
        }
      ]
    },
    // CQ_06 — Medication allergies must be known before any treatment-related advice. | يجب معرفة حساسية الأدوية قبل أي توصية علاجية.
    {
      "questionId": "CQ_06",
      "scope": "COMMON",
      "type": "SINGLE_CHOICE",
      "bodySystemId": "GENERAL",
      "questionEn": "Do you have any allergy to medicines?",
      "selected": [
        {
          "optionId": "CQ_06_NO",
          "textEn": "No"
        }
      ]
    },
    // CQ_08 — Smoking is a major risk factor for cardiovascular, respiratory, and GI disease. | التدخين عامل خطر رئيسي لأمراض القلب والصدر والجهاز الهضمي.
    {
      "questionId": "CQ_08",
      "scope": "COMMON",
      "type": "SINGLE_CHOICE",
      "bodySystemId": "GENERAL",
      "questionEn": "Do you smoke?",
      "selected": [
        {
          "optionId": "CQ_08_NEVER",
          "textEn": "Never smoked"
        }
      ]
    },
    // CQ_09 — Symptom duration separates acute from chronic problems and guides which questions matter. | مدة العرض تفرّق بين الحاد والمزمن وتحدد الأسئلة المهمة.
    {
      "questionId": "CQ_09",
      "scope": "COMMON",
      "type": "DURATION",
      "bodySystemId": "GENERAL",
      "questionEn": "How long ago did your main symptom start?",
      "value": 2,
      "unit": "DAYS",
      "valueInDays": 2
    },
    // CQ_10 — Sudden versus gradual onset is a core feature in assessing seriousness. | البداية المفاجئة أو التدريجية عنصر أساسي في تقييم خطورة الحالة.
    {
      "questionId": "CQ_10",
      "scope": "COMMON",
      "type": "SINGLE_CHOICE",
      "bodySystemId": "GENERAL",
      "questionEn": "How did the symptom start?",
      "selected": [
        {
          "optionId": "CQ_10_GRADUAL",
          "textEn": "Started gradually"
        }
      ]
    },
    // CP_01 — Location helps separate cardiac-type pain from chest-wall, lung, or digestive sources. | الموضع يساعد في التفريق بين ألم القلب وجدار الصدر والرئة والجهاز الهضمي.
    {
      "questionId": "CP_01",
      "scope": "SYMPTOM",
      "type": "SINGLE_CHOICE",
      "bodySystemId": "CARDIOVASCULAR",
      "questionEn": "Where is the pain mainly located?",
      "symptomId": "SYM_CHEST_PAIN",
      "selected": [
        {
          "optionId": "CP_01_RIGHT",
          "textEn": "Right side"
        }
      ]
    },
    // CP_02 — Pain character (pressure, sharp, burning, tearing) helps route toward cardiac, pleural, digestive or vascular causes. | طبيعة الألم (ضغط، حاد، حرقان، تمزق) توجّه نحو أسباب قلبية أو غشائية أو هضمية أو وعائية.
    {
      "questionId": "CP_02",
      "scope": "SYMPTOM",
      "type": "SINGLE_CHOICE",
      "bodySystemId": "CARDIOVASCULAR",
      "questionEn": "How would you describe the pain?",
      "symptomId": "SYM_CHEST_PAIN",
      "selected": [
        {
          "optionId": "CP_02_SHARP",
          "textEn": "Sharp or stabbing"
        }
      ]
    },
    // CP_03 — Radiation pattern is an important feature when assessing cardiac and aortic pain. | نمط انتشار الألم عنصر مهم في تقييم ألم القلب والشريان الأورطي.
    {
      "questionId": "CP_03",
      "scope": "SYMPTOM",
      "type": "MULTIPLE_CHOICE",
      "bodySystemId": "CARDIOVASCULAR",
      "questionEn": "Does the pain spread to other areas? (select all that apply)",
      "symptomId": "SYM_CHEST_PAIN",
      "selected": [
        {
          "optionId": "CP_03_NO_SPREAD",
          "textEn": "Does not spread"
        }
      ]
    },
    // CP_04 — Triggers and relieving factors (exertion, rest, breathing, position) help distinguish cardiac, pleuritic, musculoskeletal and digestive pain. | المحفزات وما يخفف الألم تساعد في التفريق بين الألم القلبي والجنبي والعضلي والهضمي.
    {
      "questionId": "CP_04",
      "scope": "SYMPTOM",
      "type": "MULTIPLE_CHOICE",
      "bodySystemId": "CARDIOVASCULAR",
      "questionEn": "When does the pain occur or get worse? (select all that apply)",
      "symptomId": "SYM_CHEST_PAIN",
      "selected": [
        {
          "optionId": "CP_04_MEALS_LYING",
          "textEn": "Worse after meals or lying down"
        }
      ]
    },
    // SH_01 — A standard self-rated severity score used to track and communicate pain intensity. | مقياس قياسي لتقييم شدة الألم ذاتيًا ومتابعته.
    {
      "questionId": "SH_01",
      "scope": "SHARED",
      "type": "SCALE",
      "bodySystemId": "GENERAL",
      "questionEn": "On a scale from 0 (none) to 10 (worst imaginable), how severe is the pain right now?",
      "usedBySymptoms": [
        "SYM_CHEST_PAIN"
      ],
      "value": 3
    },
    // CP_05 — Associated symptoms help assess seriousness and the likely system involved. | الأعراض المصاحبة تساعد في تقييم الخطورة والجهاز المصاب.
    {
      "questionId": "CP_05",
      "scope": "SYMPTOM",
      "type": "MULTIPLE_CHOICE",
      "bodySystemId": "CARDIOVASCULAR",
      "questionEn": "Do you have any of these along with the pain? (select all that apply)",
      "symptomId": "SYM_CHEST_PAIN",
      "selected": [
        {
          "optionId": "CP_05_NONE",
          "textEn": "None of these"
        }
      ]
    },
    // CP_06 — Episode length helps separate brief, recurrent pain from prolonged pain. | مدة النوبة تفرّق بين الألم القصير المتكرر والألم المطوّل.
    {
      "questionId": "CP_06",
      "scope": "SYMPTOM",
      "type": "DURATION",
      "bodySystemId": "CARDIOVASCULAR",
      "questionEn": "How long does each episode of pain last?",
      "symptomId": "SYM_CHEST_PAIN",
      "value": 10,
      "unit": "MINUTES",
      "valueInDays": 0.006944444444444445
    },
    // CP_07 — Recurrent versus new pain changes the approach and the follow-up questions. | الألم المتكرر مقابل الجديد يغيّر المسار والأسئلة التالية.
    {
      "questionId": "CP_07",
      "scope": "SYMPTOM",
      "type": "SINGLE_CHOICE",
      "bodySystemId": "CARDIOVASCULAR",
      "questionEn": "Have you had chest pain like this before?",
      "symptomId": "SYM_CHEST_PAIN",
      "selected": [
        {
          "optionId": "CP_07_FIRST",
          "textEn": "This is the first time"
        }
      ]
    },
    // SH_03 — Rapid worsening is a general warning sign that can prompt urgent advice. | التدهور السريع علامة تحذيرية عامة قد تستدعي نصيحة عاجلة.
    {
      "questionId": "SH_03",
      "scope": "SHARED",
      "type": "SINGLE_CHOICE",
      "bodySystemId": "GENERAL",
      "questionEn": "Is your main symptom getting worse quickly (over minutes to hours)?",
      "usedBySymptoms": [
        "SYM_CHEST_PAIN"
      ],
      "selected": [
        {
          "optionId": "SH_03_NO",
          "textEn": "No"
        }
      ]
    }
  ],
  // Actual engine traversal, including shared questions once; backend should replay and verify it.
  "pathTaken": [
    "CQ_01",
    "CQ_02",
    "CQ_04",
    "CQ_05",
    "CQ_06",
    "CQ_08",
    "CQ_09",
    "CQ_10",
    "CP_01",
    "CP_02",
    "CP_03",
    "CP_04",
    "SH_01",
    "CP_05",
    "CP_06",
    "CP_07",
    "SH_03"
  ]
}
